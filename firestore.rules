rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.email == 'aujudgemate@judgemate.invalid';
    }

    function profileExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function judgeFor(eventId) {
      return profileExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'judge'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.eventId == eventId;
    }

    function activeJudgeFor(eventId) {
      return judgeFor(eventId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function eventData(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function assigned(eventId, teamId) {
      return activeJudgeFor(eventId)
        && eventData(eventId).status == 'ACTIVE'
        && request.auth.uid in eventData(eventId).assignments[teamId];
    }

    match /users/{uid} {
      allow read: if admin() || (signedIn() && request.auth.uid == uid);
      allow write: if admin();
    }

    match /events/{eventId} {
      allow read, create, delete: if admin();
      allow update: if admin() || (
        activeJudgeFor(eventId)
        && resource.data.status == 'ACTIVE'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoreRevision', 'lastScoreTeamId'])
        && request.resource.data.scoreRevision == resource.data.scoreRevision + 1
        && request.resource.data.lastScoreTeamId is string
        && request.auth.uid in resource.data.assignments[request.resource.data.lastScoreTeamId]
      );

      match /adminCredentials/{judgeId} {
        allow read, write: if admin();
      }

      match /judgeViews/{uid} {
        allow read: if admin() || (signedIn() && request.auth.uid == uid && judgeFor(eventId));
        allow write: if admin();
      }

      match /criteria/{criterionId} {
        allow read, write: if admin();
      }

      match /evaluations/{evaluationId} {
        allow read: if admin() || (judgeFor(eventId) && resource.data.judgeUid == request.auth.uid);
        allow create, update: if admin() || (activeJudgeFor(eventId)
          && eventData(eventId).status == 'ACTIVE'
          && request.resource.data.keys().hasOnly(['teamId', 'judgeUid', 'feedback', 'version', 'updatedAt'])
          && request.resource.data.keys().hasAll(['teamId', 'judgeUid', 'feedback', 'version', 'updatedAt'])
          && request.resource.data.judgeUid == request.auth.uid
          && request.resource.data.teamId is string
          && assigned(eventId, request.resource.data.teamId)
          && request.resource.data.feedback is string
          && request.resource.data.feedback.size() <= 5000
          && request.resource.data.version is int
          && request.resource.data.updatedAt == request.time);
        allow delete: if false;

        match /scores/{criterionId} {
          function evaluationAfter() {
            return getAfter(/databases/$(database)/documents/events/$(eventId)/evaluations/$(evaluationId)).data;
          }

          function criterionData() {
            return get(/databases/$(database)/documents/events/$(eventId)/criteria/$(criterionId)).data;
          }

          allow read: if admin() || (judgeFor(eventId) && get(/databases/$(database)/documents/events/$(eventId)/evaluations/$(evaluationId)).data.judgeUid == request.auth.uid);
          allow create, update: if admin() || (activeJudgeFor(eventId)
            && eventData(eventId).status == 'ACTIVE'
            && evaluationAfter().judgeUid == request.auth.uid
            && assigned(eventId, evaluationAfter().teamId)
            && exists(/databases/$(database)/documents/events/$(eventId)/criteria/$(criterionId))
            && request.resource.data.keys().hasOnly(['score', 'updatedAt'])
            && request.resource.data.keys().hasAll(['score', 'updatedAt'])
            && request.resource.data.score is number
            && request.resource.data.score >= 0
            && request.resource.data.score <= criterionData().max
            && request.resource.data.updatedAt == request.time);
          allow delete: if false;
        }
      }
    }
  }
}
